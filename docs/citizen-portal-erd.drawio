        <mxCell id="note-how" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#0f172a&quot;&gt;How to read this&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;  primary key, the row's own id&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;  foreign key, it points at another table&lt;br&gt;&lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt;  unique, no two rows can share it&lt;br&gt;&lt;br&gt;Fork = many. &amp;nbsp; Circle = optional. &amp;nbsp; Bar = exactly one.&lt;br&gt;A solid line is a real database link. The dashed line is only a matching name." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;spacingBottom=10;fontSize=13;fontFamily=Helvetica;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="40" y="576" width="360" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="note-means" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#0f172a&quot;&gt;What the data means&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;A resident submits one &lt;b&gt;applicant&lt;/b&gt; record. An &lt;b&gt;admin&lt;/b&gt; reviews it.&lt;br&gt;Status is Pending, Approved, or Rejected.&lt;br&gt;After approval, rejection_reason can also say Verified or Card Delivered.&lt;br&gt;Admin roles are Super Admin, Administrator, and Verifier.&lt;br&gt;Deleting an admin deletes that admin's activity logs, and clears verified_by.&lt;br&gt;Barangay is saved as text. The barangays list is not enforced by a foreign key.&lt;br&gt;Laravel tables (users, sessions, cache, jobs) are left off this page." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;spacingBottom=10;fontSize=13;fontFamily=Helvetica;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="40" y="908" width="1520" height="190" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
